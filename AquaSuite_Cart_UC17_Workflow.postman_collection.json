        {
          "name": "TC-11. Gửi số lượng = 0 -> 400 Validation Error (SYS_003)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('HTTP 400 & Trả về lỗi validation trường quantity', function () {",
                  "    pm.response.to.have.status(400);",
                  "    var res = pm.response.json();",
                  "    pm.expect(res.success).to.eql(false);",
                  "    pm.expect(res.errors).to.be.an('array').that.is.not.empty;",
                  "    pm.expect(res.errors[0].field).to.eql('quantity');",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
