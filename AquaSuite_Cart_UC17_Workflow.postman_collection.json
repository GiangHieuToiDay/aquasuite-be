                "exec": [
                  "pm.test('HTTP 404 & Trả về mã lỗi SALES_026 (CART_ITEM_NOT_FOUND)', function () {",
                  "    pm.response.to.have.status(404);",
                  "    var res = pm.response.json();",
                  "    pm.expect(res.success).to.eql(false);",
                  "    pm.expect(res.code).to.eql('SALES_026');",
