              "var res = pm.response.json();",
              "if (res.data && res.data.products && res.data.products.content && res.data.products.content.length > 0) {",
              "    pm.collectionVariables.set('productId', res.data.products.content[0].productId);",
              "    console.log('Đã cập nhật productId từ kết quả tìm kiếm:', res.data.products.content[0].productId);",
              "}"
