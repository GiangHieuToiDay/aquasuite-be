  "item": [
    {
      "name": "1. Lấy dữ liệu Faceted Filter Sidebar",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test('Status code is 200 OK', function () {",
              "    pm.response.to.have.status(200);",
              "});",
              "var res = pm.response.json();",
              "if (res.data) {",
              "    if (res.data.categories && res.data.categories.length > 0) {",
              "        pm.collectionVariables.set('categoryId', res.data.categories[0].categoryId);",
              "        console.log('Đã tự động lưu categoryId:', res.data.categories[0].categoryId);",
              "    }",
              "    if (res.data.brands && res.data.brands.length > 0) {",
              "        pm.collectionVariables.set('brandId', res.data.brands[0].brandId);",
              "        console.log('Đã tự động lưu brandId:', res.data.brands[0].brandId);",
              "    }",
              "}"
            ],
            "type": "text/javascript"
          }
        }
      ],
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/api/v1/catalog/storefront/facets",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "v1",
            "catalog",
            "storefront",
            "facets"
          ]
        },
        "description": "Lấy các bộ lọc sidebar bên trái: Categories (kèm số lượng SP), Brands (kèm số lượng SP), Khoảng giá Min-Max để dựng Slider, Danh sách Màu sắc, Kích thước, và Thông số kỹ thuật mặt định (Flushing type, Rough-in dimension, Glaze technology)."
      },
      "response": []
    },
    {
      "name": "2. Xem danh mục sản phẩm (Normal Flow - Mặc định không lọc)",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test('Status code is 200 OK', function () {",
              "    pm.response.to.have.status(200);",
              "});",
              "var res = pm.response.json();",
              "pm.test('Có dữ liệu phân trang sản phẩm', function () {",
              "    pm.expect(res.data).to.have.property('products');",
              "});",
              "if (res.data && res.data.products && res.data.products.content && res.data.products.content.length > 0) {",
              "    var firstProduct = res.data.products.content[0];",
              "    pm.collectionVariables.set('productId', firstProduct.productId);",
              "    console.log('Đã tự động lưu productId:', firstProduct.productId);",
              "}"
            ],
            "type": "text/javascript"
          }
        }
      ],
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/api/v1/catalog/storefront/search?page=0&size=10",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "v1",
            "catalog",
            "storefront",
            "search"
          ],
          "query": [
            {
              "key": "page",
              "value": "0",
              "description": "Số trang (bắt đầu từ 0)"
            },
            {
              "key": "size",
              "value": "10",
              "description": "Số sản phẩm trên 1 trang"
            }
          ]
        },
        "description": "Mô phỏng người dùng vừa vào trang Danh mục sản phẩm (Storefront / POS) xem danh sách tất cả sản phẩm đang ACTIVE, phân trang 10 sản phẩm/trang. Tự động lưu productId của sản phẩm đầu tiên."
      },
      "response": []
    },
