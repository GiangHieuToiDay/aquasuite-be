              "});",
              "var res = pm.response.json();",
              "pm.test('Mã lỗi CAT_001 chuẩn nghiệp vụ Catalog', function () {",
              "    pm.expect(res.code).to.eql('CAT_001');",
              "});"
            ],
            "type": "text/javascript"
          }
        }
