    {
      "name": "7. Xem Chi tiết Sản phẩm - Góc nhìn Khách hàng (Customer / Guest View)",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test('Status code is 200 OK', function () {",
              "    pm.response.to.have.status(200);",
              "});",
              "var res = pm.response.json();",
              "pm.test('Khách hàng không nhìn thấy warehouseBreakdown của kho', function () {",
              "    if (res.data.variants && res.data.variants.length > 0) {",
              "        pm.expect(res.data.variants[0].isSalesStaff).to.be.false;",
              "        pm.expect(res.data.variants[0].warehouseBreakdown).to.be.null;",
              "    }",
              "});",
              "pm.test('Có thông tin CAD blueprint, tài liệu hướng dẫn PDF và điều khoản bảo hành', function () {",
              "    pm.expect(res.data).to.have.property('cadBlueprints');",
              "    pm.expect(res.data).to.have.property('installationManualPdf');",
              "    pm.expect(res.data).to.have.property('warrantyTerms');",
              "});"
            ],
            "type": "text/javascript"
          }
        }
      ],
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/api/v1/catalog/storefront/products/{{productId}}",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "v1",
            "catalog",
            "storefront",
            "products",
            "{{productId}}"
          ]
        },
        "description": "Xem trang chi tiết sản phẩm toàn diện cho Khách hàng vãng lai / Khách mua hàng: Thư viện ảnh zoom, CAD blueprint, file hướng dẫn PDF, điều khoản bảo hành, bộ chọn biến thể (Variant selector), trạng thái tồn kho tổng quát (In Stock / Out of Stock). Thuộc tính warehouseBreakdown bị ẩn (null)."
      },
      "response": []
    },
    {
      "name": "8. Xem Chi tiết Sản phẩm - Góc nhìn Nhân viên Bán hàng (Sales Staff / POS View)",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test('Status code is 200 OK', function () {",
              "    pm.response.to.have.status(200);",
              "});",
              "var res = pm.response.json();",
              "pm.test('Nhân viên bán hàng nhìn thấy chi tiết kho (warehouseBreakdown)', function () {",
              "    if (res.data.variants && res.data.variants.length > 0 && res.data.variants[0].isSalesStaff) {",
              "        pm.expect(res.data.variants[0].warehouseBreakdown).to.be.an('array');",
              "    }",
              "});"
            ],
            "type": "text/javascript"
          }
        }
      ],
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{salesStaffToken}}",
            "type": "text",
            "description": "JWT Token của Sales Staff hoặc Admin để xem tồn kho từng kho"
          }
        ],
        "url": {
          "raw": "{{baseUrl}}/api/v1/catalog/storefront/products/{{productId}}",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "v1",
            "catalog",
            "storefront",
            "products",
            "{{productId}}"
          ]
        },
        "description": "Xem chi tiết sản phẩm với quyền Sales Staff / Admin: Hiển thị thêm chi tiết số lượng thực tế theo từng kho hàng (warehouseCode, onHandQty, reservedQty, availableQty)."
      },
      "response": []
    },
    {
      "name": "9. Kiểm tra lỗi 404 khi xem sản phẩm không tồn tại (Validation / Error Handling)",
