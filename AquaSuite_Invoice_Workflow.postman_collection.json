            },
            "url": {
              "raw": "{{baseUrl}}/api/v1/sales/invoices/{{retailInvoiceId}}",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "v1",
                "sales",
                "invoices",
                "{{retailInvoiceId}}"
              ]
            }
          }
        },
        {
          "name": "TC-10. Chốt & Phát hành hóa đơn lẻ (DRAFT -> ISSUED)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('HTTP 200 & Chuyển status=ISSUED, editable=false', function () {",
                  "    pm.response.to.have.status(200);",
                  "    var inv = pm.response.json().data;",
                  "    pm.expect(inv.status).to.eql('ISSUED');",
                  "    pm.expect(inv.editable).to.eql(false);",
                  "    pm.expect(inv.issuedAt).to.not.be.null;",
                  "});"
