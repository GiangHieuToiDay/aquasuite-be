  "item": [
    {
      "name": "00. Setup & Đăng nhập",
      "item": [
        {
          "name": "TC-01. Đăng nhập SALES_STAFF",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('HTTP 200 & Có access_token cho SALES_STAFF', function () {",
                  "    pm.response.to.have.status(200);",
                  "    var res = pm.response.json();",
                  "    pm.expect(res.success).to.eql(true);",
                  "    pm.expect(res.data.access_token).to.be.a('string').and.not.empty;",
                  "    pm.collectionVariables.set('salesToken', res.data.access_token);",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"{{salesEmail}}\",\n  \"password\": \"{{testPassword}}\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/v1/auth/login",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "v1",
                "auth",
                "login"
              ]
            }
          }
        },
        {
          "name": "TC-02. Đăng nhập ACCOUNTANT",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('HTTP 200 & Có access_token cho ACCOUNTANT', function () {",
                  "    pm.response.to.have.status(200);",
                  "    var res = pm.response.json();",
                  "    pm.expect(res.data.access_token).to.be.a('string').and.not.empty;",
                  "    pm.collectionVariables.set('accountantToken', res.data.access_token);",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"{{accountantEmail}}\",\n  \"password\": \"{{testPassword}}\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/v1/auth/login",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "v1",
                "auth",
                "login"
              ]
            }
          }
        },
        {
          "name": "TC-03. Lấy Customer mẫu ACTIVE",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('HTTP 200 & Lấy customerId đầu tiên', function () {",
                  "    pm.response.to.have.status(200);",
                  "    var res = pm.response.json();",
                  "    pm.expect(res.data.length).to.be.above(0);",
                  "    pm.collectionVariables.set('customerId', res.data[0].customerId);",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{salesToken}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/v1/customers/options",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "v1",
                "customers",
                "options"
              ]
            }
          }
        },
        {
          "name": "TC-04. Lấy 2 Variant ACTIVE còn tồn kho",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('HTTP 200 & Chọn 2 SKU còn tồn kho >= 20', function () {",
                  "    pm.response.to.have.status(200);",
                  "    var items = pm.response.json().data.filter(i => !i.isCombo && Number(i.availableStock) >= 20);",
                  "    pm.expect(items.length).to.be.at.least(2);",
                  "    pm.collectionVariables.set('variant1Id', items[0].variantId);",
                  "    pm.collectionVariables.set('variant2Id', items[1].variantId);",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{salesToken}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/v1/sales/catalog-items",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "v1",
                "sales",
                "catalog-items"
              ]
            }
          }
        }
      ]
    },
    {
      "name": "01. Luồng Đơn Lẻ POS (STORE Invoice DRAFT -> ISSUED)",
      "item": [
        {
          "name": "TC-05. Tạo đơn lẻ POS -> Tự sinh hóa đơn STORE DRAFT",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('HTTP 201 & Tự khởi tạo 1 hóa đơn DRAFT', function () {",
                  "    pm.response.to.have.status(201);",
                  "    var data = pm.response.json().data;",
                  "    pm.expect(data.orderType).to.eql('RETAIL');",
                  "    pm.expect(data.orderStatus).to.eql('PROCESSING');",
                  "    pm.expect(data.storeInvoiceId).to.be.a('string').and.not.empty;",
                  "    pm.expect(data.totalInvoiceCount).to.eql(1);",
                  "    pm.expect(data.draftInvoiceCount).to.eql(1);",
                  "    pm.expect(data.issuedInvoiceCount).to.eql(0);",
                  "    pm.collectionVariables.set('retailOrderId', data.orderId);",
                  "    pm.collectionVariables.set('retailInvoiceId', data.storeInvoiceId);",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{salesToken}}"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"customerId\": \"{{customerId}}\",\n  \"orderChannel\": \"POS\",\n  \"orderType\": \"RETAIL\",\n  \"fulfillmentMethod\": \"IN_STORE_PICKUP\",\n  \"paymentMethod\": \"CASH\",\n  \"discountAmount\": 100000,\n  \"note\": \"[PM-TEST] Đơn bán lẻ tại quầy\",\n  \"items\": [\n    { \"variantId\": \"{{variant1Id}}\", \"quantity\": 2 }\n  ]\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/v1/sales/orders",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "v1",
                "sales",
                "orders"
              ]
            }
          }
        },
        {
          "name": "TC-06. Lấy danh sách hóa đơn của đơn lẻ",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('HTTP 200 & Hóa đơn có invoiceType=STORE, status=DRAFT, editable=true', function () {",
                  "    pm.response.to.have.status(200);",
                  "    var list = pm.response.json().data;",
                  "    pm.expect(list.length).to.eql(1);",
                  "    pm.expect(list[0].invoiceType).to.eql('STORE');",
                  "    pm.expect(list[0].status).to.eql('DRAFT');",
                  "    pm.expect(list[0].editable).to.eql(true);",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{salesToken}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/v1/sales/orders/{{retailOrderId}}/invoices",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "v1",
                "sales",
                "orders",
                "{{retailOrderId}}",
                "invoices"
              ]
            }
          }
        },
        {
          "name": "TC-07. Sửa hóa đơn STORE khi đang DRAFT (Đổi SL + Thêm SKU)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('HTTP 200 & Cập nhật 2 dòng hàng thành công', function () {",
                  "    pm.response.to.have.status(200);",
                  "    var inv = pm.response.json().data;",
                  "    pm.expect(inv.status).to.eql('DRAFT');",
                  "    pm.expect(inv.items.length).to.eql(2);",
                  "    pm.expect(Number(inv.discountAmount)).to.eql(200000);",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "PUT",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{salesToken}}"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"batchName\": \"Hóa đơn bán lẻ (Đã sửa)\",\n  \"note\": \"[PM-TEST] Tăng SL & thêm SKU 2\",\n  \"discountAmount\": 200000,\n  \"items\": [\n    { \"variantId\": \"{{variant1Id}}\", \"quantity\": 3 },\n    { \"variantId\": \"{{variant2Id}}\", \"quantity\": 1 }\n  ]\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/v1/sales/invoices/{{retailInvoiceId}}",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
