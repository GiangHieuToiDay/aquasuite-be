          "name": "TC-08. Xác nhận Đơn hàng tự đồng bộ theo hóa đơn nháp",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('HTTP 200 & Order đồng bộ đúng 2 mặt hàng và discountAmount=200000', function () {",
                  "    pm.response.to.have.status(200);",
                  "    var order = pm.response.json().data;",
                  "    pm.expect(order.items.length).to.eql(2);",
                  "    pm.expect(Number(order.discountAmount)).to.eql(200000);",
                  "});"
                ],
                "type": "text/javascript"
