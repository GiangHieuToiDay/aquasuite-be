# ==============================================================================
# AquaSuite Backend - Environment Variables Example
# ==============================================================================
# LƯU Ý QUAN TRỌNG:
# 1. File này CHỈ LÀ BẢN MẪU TÀI LIỆU (placeholder), TUYỆT ĐỐI KHÔNG chứa secret thật.
# 2. KHÔNG sử dụng nguyên bản các giá trị placeholder này trên môi trường Production.
# 3. Spring Boot KHÔNG tự động đọc file .env khi khởi chạy; nhà phát triển cần
#    thiết lập biến môi trường qua shell/process runner hoặc secret manager.
# 4. KHÔNG commit file .env hoặc các file chứa credential thật vào Git repository.
# ==============================================================================

# Active Spring Profile (ví dụ local development: dev, test, prod).
# Lưu ý: Không hardcode active profile trong bất kỳ file application*.yml nào.
SPRING_PROFILES_ACTIVE=dev

# Cấu hình kết nối cơ sở dữ liệu PostgreSQL (chỉ cung cấp khi cần kết nối database thật)
# Thay thế các giá trị bên dưới bằng thông tin kết nối thực tế trên môi trường chạy:
SPRING_DATASOURCE_URL=<replace-with-local-or-managed-jdbc-url>
SPRING_DATASOURCE_USERNAME=<replace-with-username>
SPRING_DATASOURCE_PASSWORD=<replace-with-secret>

# Schema được quản lý bằng migration; không tạo lại bảng khi khởi động.
SPRING_JPA_HIBERNATE_DDL_AUTO=validate

# SMTP: cung cấp tài khoản và secret qua môi trường, không lưu credential thật ở đây.
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=<replace-with-smtp-username>
MAIL_PASSWORD=<replace-with-smtp-secret>
# Cấu hình bảo mật JWT (HS512 signing secret ngẫu nhiên tối thiểu 64 bytes sau decode)
JWT_SECRET=<replace-with-at-least-64-bytes-secret>

# Cấu hình kết nối Redis
SPRING_DATA_REDIS_HOST=<replace-with-redis-host>
SPRING_DATA_REDIS_PORT=6379
SPRING_DATA_REDIS_PASSWORD=<replace-with-redis-password>
SPRING_REDIS_SSL_ENABLED=true

# Biến môi trường cho Docker Compose Redis
REDIS_PASSWORD=<replace-with-redis-password>

# Cấu hình Development Data Initializer (FEATURE-009)
# Biến môi trường bắt buộc khi bật dev-seed (aquasuite.iam.dev-seed.enabled=true trên profile dev)
# TUYỆT ĐỐI KHÔNG commit mật khẩu thật vào repository
AQUASUITE_DEV_OWNER_PASSWORD=<replace-with-secure-dev-password>
