meta {
  name: 08 - Download Transfer Proof
  type: http
  seq: 8
}

get {
  url: {{baseUrl}}/api/v1/finance/orders/{{paymentOrderId}}/payments/{{paymentBankId}}/proof
  body: none
  auth: bearer
}

auth:bearer {
  token: {{accessToken}}
}

tests {
  test('Proof is returned as a file', function () {
    expect(res.getStatus()).to.equal(200);
    expect(res.getHeader('content-type')).to.match(/^(image\/(png|jpeg)|application\/pdf)/i);
  });
}
