meta {
  name: 09 - Delete Unassigned Permission
  type: http
  seq: 9
}

delete {
  url: {{baseUrl}}/api/v1/iam/permissions/{{tempPermissionId}}
  body: none
  auth: bearer
}

auth:bearer {
  token: {{accessToken}}
}

tests {
  test('Returns HTTP 200 and data field is omitted in JSON', function () {
    expect(res.getStatus()).to.equal(200);
    const body = res.getBody();
    expect(body.success).to.equal(true);
    expect(body.code).to.equal('SUCCESS');
    expect(body.message).to.equal('Thành công');
    expect(body.timestamp).to.be.a('string').and.not.empty;
    expect(body.data).to.be.undefined;
  });
}
