meta {
  name: 07 - Update Permission Description
  type: http
  seq: 7
}

patch {
  url: {{baseUrl}}/api/v1/iam/permissions/{{permissionId}}
  body: json
  auth: bearer
}

headers {
  Content-Type: application/json
}

auth:bearer {
  token: {{accessToken}}
}

body:json {
  {
    "description": "Mô tả mới đã được cập nhật qua Bruno test"
  }
}

tests {
  test('Returns HTTP 200 with updated description', function () {
    expect(res.getStatus()).to.equal(200);
    const body = res.getBody();
    expect(body.success).to.equal(true);
    expect(body.code).to.equal('SUCCESS');
    expect(body.data.id).to.equal(bru.getVar('permissionId'));
    expect(body.data.code).to.equal(bru.getVar('permissionCode'));
    expect(body.data.description).to.equal('Mô tả mới đã được cập nhật qua Bruno test');
    expect(body.data.createdAt).to.be.undefined;
    expect(body.data.updatedAt).to.be.undefined;
  });
}
