meta {
  name: 02 - Get Brand Detail
  type: http
  seq: 2
}

get {
  url: {{baseUrl}}/api/v1/catalog/brands/{{brandId}}
  body: none
  auth: bearer
}

auth:bearer {
  token: {{accessToken}}
}

tests {
  test('Returns HTTP 200 with brand details', function () {
    expect(res.getStatus()).to.equal(200);
    const body = res.getBody();
    expect(body.success).to.equal(true);
    expect(body.code).to.equal('SUCCESS');
    expect(body.data.id).to.equal(bru.getVar('brandId'));
    expect(body.data.code).to.equal(bru.getVar('brandCode'));
  });
}
