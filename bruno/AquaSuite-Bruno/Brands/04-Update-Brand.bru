meta {
  name: 04 - Update Brand
  type: http
  seq: 4
}

put {
  url: {{baseUrl}}/api/v1/catalog/brands/{{brandId}}
  body: json
  auth: bearer
}

headers {
  Content-Type: application/json
}

auth:bearer {
  token: {{accessToken}}
}

body:json {
  {
    "name": "Thương hiệu đã cập nhật WORK-013",
    "description": "Mô tả thương hiệu sau cập nhật",
    "status": "INACTIVE"
  }
}

tests {
  test('Returns HTTP 200 with updated brand', function () {
    expect(res.getStatus()).to.equal(200);
    const body = res.getBody();
    expect(body.success).to.equal(true);
    expect(body.code).to.equal('SUCCESS');
    expect(body.data.id).to.equal(bru.getVar('brandId'));
    expect(body.data.name).to.equal('Thương hiệu đã cập nhật WORK-013');
    expect(body.data.status).to.equal('INACTIVE');
  });
}
