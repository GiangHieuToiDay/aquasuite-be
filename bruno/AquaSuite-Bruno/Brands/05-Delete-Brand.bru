meta {
  name: 05 - Delete Brand
  type: http
  seq: 5
}

delete {
  url: {{baseUrl}}/api/v1/catalog/brands/{{brandId}}
  body: none
  auth: bearer
}

auth:bearer {
  token: {{accessToken}}
}

tests {
  test('Returns HTTP 200 with omitted data', function () {
    expect(res.getStatus()).to.equal(200);
    const body = res.getBody();
    expect(body.success).to.equal(true);
    expect(body.code).to.equal('SUCCESS');
    expect(body.data).to.be.undefined;
  });
}
