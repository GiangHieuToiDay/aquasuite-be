meta {
  name: 05 - Update Category
  type: http
  seq: 5
}

put {
  url: {{baseUrl}}/api/v1/catalog/categories/{{categoryId}}
  body: json
  auth: bearer
}

headers {
  Content-Type: application/json
}

auth:bearer {
  token: {{accessToken}}
}

body:json {
  {
    "name": "Danh mục đã cập nhật WORK-013",
    "description": "Mô tả danh mục sau khi cập nhật",
    "status": "INACTIVE"
  }
}

tests {
  test('Returns HTTP 200 with updated fields', function () {
    expect(res.getStatus()).to.equal(200);
    const body = res.getBody();
    expect(body.success).to.equal(true);
    expect(body.code).to.equal('SUCCESS');
    expect(body.data.id).to.equal(bru.getVar('categoryId'));
    expect(body.data.name).to.equal('Danh mục đã cập nhật WORK-013');
    expect(body.data.status).to.equal('INACTIVE');
  });
}
