meta {
  name: 10 - Create Revision (Tạo phiên bản mới)
  type: http
  seq: 10
}

post {
  url: {{baseUrl}}/api/v1/sales/quotations/{{quotationId}}/revisions
  body: none
  auth: bearer
}

auth:bearer {
  token: {{accessToken}}
}

script:post-response {
  const body = res.getBody();
  if (res.getStatus() === 201 && body && body.data) {
    bru.setVar('revisionQuotationId', body.data.quotationId);
    console.log("Created Revision ID:", body.data.quotationId);
    console.log("Revision No:", body.data.revisionNo);
  }
}

tests {
  test("Tạo phiên bản sửa đổi mới thành công (HTTP 201 Created)", function () {
    // Nếu báo giá gốc đang ở trạng thái SENT, API sẽ trả về 201
    // Nếu chưa chuyển SENT, hệ thống sẽ trả về lỗi nghiệp vụ 400 QUOTATION_NOT_SENT
    if (res.getStatus() === 201) {
      const body = res.getBody();
      expect(body.success).to.equal(true);
      expect(body.data.revisionNo).to.be.greaterThan(1);
      expect(body.data.status).to.equal("DRAFT");
      expect(body.data.parentQuotationId).to.equal(bru.getVar('quotationId'));
    } else {
      expect(res.getStatus()).to.equal(400);
      const body = res.getBody();
      expect(body.code).to.equal("QUOTATION_NOT_SENT");
    }
  });
}
