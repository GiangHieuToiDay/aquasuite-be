meta {
  name: 11 - Mark Accepted (Chốt đơn thành công)
  type: http
  seq: 11
}

post {
  url: {{baseUrl}}/api/v1/sales/quotations/{{quotationId}}/accept
  body: json
  auth: bearer
}

headers {
  Content-Type: application/json
}

auth:bearer {
  token: {{accessToken}}
}

body:json {
  {
    "signedFileUrl": "https://storage.aquasuite.com/contracts/riviera-contract-signed.pdf"
  }
}

tests {
  test("Chốt đơn thành công (HTTP 200 hoặc 400 nếu chưa SENT)", function () {
    if (res.getStatus() === 200) {
      const body = res.getBody();
      expect(body.success).to.equal(true);
      expect(body.data.status).to.equal("ACCEPTED");
      expect(body.data.acceptedAt).to.not.be.null;
      expect(body.data.signedFileUrl).to.include("riviera-contract-signed.pdf");
    } else {
      expect(res.getStatus()).to.equal(400);
      const body = res.getBody();
      expect(body.code).to.equal("QUOTATION_NOT_SENT");
    }
  });
}
