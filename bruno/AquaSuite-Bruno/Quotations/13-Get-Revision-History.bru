meta {
  name: 13 - Get Revision History (Lịch sử các phiên bản)
  type: http
  seq: 13
}

get {
  url: {{baseUrl}}/api/v1/sales/quotations/code/{{quotationCode}}/revisions
  body: none
  auth: bearer
}

auth:bearer {
  token: {{accessToken}}
}

tests {
  test("Lấy lịch sử các phiên bản thành công (HTTP 200)", function () {
    expect(res.getStatus()).to.equal(200);
    const body = res.getBody();
    expect(body.success).to.equal(true);
    expect(body.data).to.be.an('array');
    expect(body.data.length).to.be.greaterThan(0);
    expect(body.data[0].quotationCode).to.equal(bru.getVar('quotationCode'));
    // Kiểm tra sắp xếp giảm dần revisionNo
    if (body.data.length > 1) {
      expect(body.data[0].revisionNo).to.be.greaterThan(body.data[1].revisionNo);
    }
  });
}
