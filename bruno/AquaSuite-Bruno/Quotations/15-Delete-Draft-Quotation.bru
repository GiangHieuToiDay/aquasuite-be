meta {
  name: 15 - Delete Draft Quotation (Xóa bản nháp)
  type: http
  seq: 15
}

delete {
  url: {{baseUrl}}/api/v1/sales/quotations/{{quotationId}}
  body: none
  auth: bearer
}

auth:bearer {
  token: {{accessToken}}
}

tests {
  test("Xóa báo giá nháp thành công (HTTP 200 hoặc 400 nếu đã khóa)", function () {
    // Chỉ cho phép xóa khi còn là DRAFT Rev 1
    if (res.getStatus() === 200) {
      const body = res.getBody();
      expect(body.success).to.equal(true);
    } else {
      expect(res.getStatus()).to.equal(400);
      const body = res.getBody();
      expect(body.code).to.be.oneOf(["ONLY_DRAFT_CAN_BE_DELETED", "QUOTATION_NOT_FOUND"]);
    }
  });
}
