meta {
  name: 04 - Unassign Permission from Role
  type: http
  seq: 4
}

delete {
  url: {{baseUrl}}/api/v1/iam/roles/{{roleId}}/permissions/{{permissionId}}
  body: none
  auth: bearer
}

auth:bearer {
  token: {{accessToken}}
}

tests {
  test('Returns HTTP 200 and permission is removed from role', function () {
    expect(res.getStatus()).to.equal(200);
    const body = res.getBody();
    expect(body.success).to.equal(true);
    expect(body.code).to.equal('SUCCESS');
    expect(body.data.id).to.equal(bru.getVar('roleId'));
    const assigned = body.data.permissions.find(p => p.id === bru.getVar('permissionId'));
    expect(assigned).to.be.undefined;
  });
}
