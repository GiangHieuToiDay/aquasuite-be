meta {
  name: 05 - Unassign Permission from Role (Idempotent)
  type: http
  seq: 5
}

delete {
  url: {{baseUrl}}/api/v1/iam/roles/{{roleId}}/permissions/{{permissionId}}
  body: none
  auth: bearer
}

auth:bearer {
  token: {{accessToken}}
}

tests {
  test('Returns HTTP 200 idempotently when already unassigned', function () {
    expect(res.getStatus()).to.equal(200);
    const body = res.getBody();
    expect(body.success).to.equal(true);
    expect(body.code).to.equal('SUCCESS');
  });
}
