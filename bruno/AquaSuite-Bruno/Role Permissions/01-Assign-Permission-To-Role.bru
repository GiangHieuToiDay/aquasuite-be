meta {
  name: 01 - Assign Permission to Role
  type: http
  seq: 1
}

put {
  url: {{baseUrl}}/api/v1/iam/roles/{{roleId}}/permissions/{{permissionId}}
  body: none
  auth: bearer
}

auth:bearer {
  token: {{accessToken}}
}

tests {
  test('Returns HTTP 200 with updated role permissions list', function () {
    expect(res.getStatus()).to.equal(200);
    const body = res.getBody();
    expect(body.success).to.equal(true);
    expect(body.code).to.equal('SUCCESS');
    expect(body.data.id).to.equal(bru.getVar('roleId'));
    expect(body.data.permissions).to.be.an('array');
    const assigned = body.data.permissions.find(p => p.id === bru.getVar('permissionId'));
    expect(assigned).to.not.be.undefined;
  });
}
